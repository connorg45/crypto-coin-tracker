{
  "name": "lizard-coin-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist",
    "dev:ui": "vite",
    "build": "npm run typecheck && vite build && npm run bundle:check",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:all": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "bundle:check": "node scripts/check-bundle.mjs",
    "audit": "npm audit --audit-level=high",
    "baseline:prepare": "node scripts/prepare-legacy-baseline.mjs",
    "baseline:verify": "node scripts/verify-static-deployment.mjs",
    "lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop",
    "lighthouse:mobile": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.mobile.json",
    "lighthouse:desktop": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.desktop.json",
    "media:capture": "node scripts/capture-media.mjs",
    "metrics:api": "node scripts/measure-api.mjs",
    "metrics:web-vitals": "node scripts/measure-web-vitals.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "deploy:legacy": "npm run baseline:prepare && wrangler pages deploy .artifacts/legacy-baseline --project-name lizard-coin-tracker --branch develop --commit-hash 96466f32612274994cdd1e3b9a89ec571b798f40",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lizard-coin-tracker"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "5.20260721.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "web-vitals": "5.3.0",
    "wrangler": "4.112.0"
  }
}
